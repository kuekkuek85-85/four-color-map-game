rules_version = '2';

// 4색 지도 칠하기 게임 — Firestore 보안 규칙 (1차)
//
// 전제: 수업용 간이 식별(비밀번호 없음). 인증(Auth)을 쓰지 않으므로
// 서버에서 "본인"을 강하게 증명할 수 없다. 따라서 이 규칙은 "수업 활동
// 기록"에 맞춰 최소한의 안전장치를 둔다.
//   - students: 학번 문서는 생성/갱신만 허용(삭제 금지), 필드 형식 검증.
//   - plays: 완료 기록은 "추가만"(append-only) 허용. 수정·삭제 금지.
//   - 교사 집계 조회는 plays 읽기로 처리(운영 기간 동안만 공개).
//
// 운영 종료 후에는 아래 규칙을 모두 거부(false)로 바꾸거나 데이터를 삭제한다.
// 실제 반 운영 시에는 App Check / 기간 제한 / 교사 Auth 도입을 권장한다.

service cloud.firestore {
  match /databases/{database}/documents {

    function isFiveDigitId(id) {
      return id is string && id.matches('^[0-9]{5}$');
    }

    function validStudent(data) {
      return data.studentId is string
        && data.name is string
        && data.name.size() >= 1
        && data.name.size() <= 10;
    }

    function validPlay(data) {
      return data.studentId is string
        && isFiveDigitId(data.studentId)
        && data.name is string
        && data.levelId is string
        && data.durationSec is number && data.durationSec >= 0
        && data.colorsUsed is number && data.colorsUsed >= 0 && data.colorsUsed <= 8
        && data.violations is number && data.violations >= 0
        && data.undos is number && data.undos >= 0;
    }

    match /students/{studentId} {
      allow read: if true;
      allow create, update: if isFiveDigitId(studentId) && validStudent(request.resource.data);
      allow delete: if false;
    }

    match /plays/{playId} {
      // 교사 현황판 집계를 위해 읽기 허용(운영 기간 한정).
      allow read: if true;
      // 완료 기록은 추가만 허용. 위·변조(수정·삭제) 불가.
      allow create: if validPlay(request.resource.data);
      allow update, delete: if false;
    }

    // 지도 정의는 코드 상수로 관리(현재 Firestore 미사용). 읽기만 허용.
    match /levels/{levelId} {
      allow read: if true;
      allow write: if false;
    }
  }
}
