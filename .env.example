# Firebase 설정 (선택 사항)
#
# 아래 값을 채우면 완료 기록이 Firebase Firestore에 저장되고
# 교사 현황판에서 반 전체 기록을 집계해 볼 수 있습니다.
#
# 값을 비워 두면 앱은 자동으로 "오프라인 모드"로 동작합니다.
#   - 기록은 브라우저 localStorage에만 저장됩니다.
#   - 게임 플레이, 레벨, 내 기록 화면은 그대로 동작합니다.
#   - 교사 현황판은 해당 기기에 쌓인 기록만 보여줍니다.
#
# Firebase 콘솔 > 프로젝트 설정 > 내 앱(웹 앱)에서 값을 복사하세요.
# 이 파일을 복사해 `.env.local` 로 저장한 뒤 값을 채워 넣습니다.

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
